# URL do projeto Supabase (Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica (Publishable/anon key) do Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta do Supabase (Service Role) - NUNCA expor no frontend, usar so em API routes/server
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API do Resend, usada para enviar e-mail de notificacao de agendamento
RESEND_API_KEY=

# E-mail da proprietaria da clinica, que recebe a notificacao de novo agendamento
CLINIC_OWNER_EMAIL=
